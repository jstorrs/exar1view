{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["src/**/*.js", "tools/**/*.js", "tools/**/*.d.ts"]
}
